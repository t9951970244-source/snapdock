{
  "name": "snapdock",
  "version": "1.0.0",
  "description": "SnapDock - стеклянный мини-виджет: снимки экрана, управление любым звуком, P2P",
  "author": "SnapDock",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.snapdock.app",
    "productName": "SnapDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SnapDock-Portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "SnapDock показывает эквалайзер по звуку, который играет на компьютере.",
        "NSMicrophoneUsageDescription": "Микрофон нужен для голоса в P2P-комнате.",
        "NSCameraUsageDescription": "Камера нужна для видео-кружка в P2P-комнате.",
        "LSUIElement": true
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "icon": "build/icon.icns",
      "artifactName": "SnapDock-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "dmg": {
      "artifactName": "SnapDock-${arch}.dmg",
      "title": "SnapDock",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 570,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapDock",
      "runAfterFinish": true,
      "artifactName": "SnapDock-Setup-${version}.exe",
      "uninstallDisplayName": "SnapDock",
      "deleteAppDataOnUninstall": false
    }
  }
}